# Required in production
JWT_SECRET=replace-with-a-random-64-character-secret
DATABASE_URL=postgresql+psycopg://floodsafe:floodsafe@db:5432/floodsafe
ALLOWED_ORIGINS=http://localhost:8000
FLOODSAFE_API_KEY=replace-with-a-long-api-key
BOOTSTRAP_ADMIN_KEY=replace-with-a-one-time-bootstrap-key

# Optional live providers
OPENWEATHER_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org

# Runtime
LOG_LEVEL=INFO
ACCESS_TOKEN_MINUTES=30
