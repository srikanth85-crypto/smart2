# Required in production
JWT_SECRET=replace-with-a-random-64-character-secret
DATABASE_URL=postgresql+psycopg://floodsafe:floodsafe@db:5432/floodsafe
ALLOWED_ORIGINS=http://localhost:8000
FLOODSAFE_API_KEY=replace-with-a-long-api-key
BOOTSTRAP_ADMIN_KEY=replace-with-a-one-time-bootstrap-key

# Optional live providers
OPENWEATHER_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org

# AI intelligence layer (OpenAI-compatible endpoint)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Runtime
LOG_LEVEL=INFO
ACCESS_TOKEN_MINUTES=30

# Optional first-run responder provisioning (set only for controlled setup)
SEED_LOCAL_STAFF=false
AMBULANCE_LOGIN_EMAIL=
AMBULANCE_LOGIN_PASSWORD=
FIRE_RESCUE_LOGIN_EMAIL=
FIRE_RESCUE_LOGIN_PASSWORD=
