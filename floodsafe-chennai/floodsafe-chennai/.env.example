# All of these are OPTIONAL. FloodSafe Chennai runs fully on demo data
# with zero keys configured — nothing here is required for the demo to work.

# Real-time weather (falls back to demo weather data if unset)
OPENWEATHER_API_KEY=

# AI Flood Assistant (falls back to the built-in rule-based assistant if unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OSRM or another routing provider base URL (falls back to the built-in
# demo distance/risk model if unset or unreachable)
OSRM_BASE_URL=

# USSD gateway provider credentials (only needed for a real telecom
# integration — never hard-code these in code)
USSD_PROVIDER_API_KEY=
USSD_PROVIDER_URL=
